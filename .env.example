# Optional AI coach. Copy this file to .env.local; never commit real values.
# The poker game, graphs and deterministic explanations work without a key.
# Server-only: NEVER prefix these with VITE_.
AI_GATEWAY_API_KEY=
COACH_MODEL=anthropic/claude-sonnet-5.5

# Required by `npm start` (private Node deployment); choose a long random token.
# This is a site-access token, NOT the provider key. Enter it in the coach UI.
COACH_ACCESS_TOKEN=
# Explicit comma-separated browser origins; add your HTTPS host if deploying.
COACH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-process allowance. Restarts reset it. Not a durable billing limit.
COACH_REQUEST_BUDGET=30
COACH_PORT=3001
